# Client-side auth
VITE_CLERK_PUBLISHABLE_KEY=

# Optional server-side Clerk value for future backend auth checks.
CLERK_SECRET_KEY=

# Client-side Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI mode
VITE_ENABLE_REAL_AI=false
VITE_AI_QUESTION_ENDPOINT=/api/generate-questions
VITE_AI_FEEDBACK_ENDPOINT=/api/generate-feedback

# Server-only OpenAI values. Do not prefix the API key with VITE.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stream Video
VITE_STREAM_API_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=
VITE_STREAM_USER_TOKEN=
VITE_STREAM_TOKEN_ENDPOINT=/api/stream-token
